              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@vehicleservice.com\",\n  \"password\": \"admin123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": ["{{baseUrl}}"],
