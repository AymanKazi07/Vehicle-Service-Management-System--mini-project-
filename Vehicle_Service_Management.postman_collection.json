{
  "info": {
    "_postman_id": "vehicle-service-management-v2",
    "name": "Vehicle Service Management API",
    "description": "Complete Postman collection for Vehicle Service System with RBAC (Customer, Mechanic, Admin) and automated collection runner support.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080",
      "type": "string"
    },
    {
      "key": "customerToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "mechanicToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "adminToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "bookingId",
      "value": "",
      "type": "string"
    },
    {
      "key": "jobId",
      "value": "",
      "type": "string"
    },
    {
      "key": "customerEmail",
      "value": "customer_test@example.com",
      "type": "string"
    },
    {
      "key": "regNo",
      "value": "MH12AB5566",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Customer Flow",
      "item": [
        {
          "name": "1.1 Customer Signup",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "var randomSuffix = Math.floor(Math.random() * 90000) + 10000;",
                  "var email = 'user_' + randomSuffix + '@example.com';",
                  "var reg = 'MH12AB' + (Math.floor(Math.random() * 9000) + 1000);",
                  "pm.collectionVariables.set('customerEmail', email);",
                  "pm.collectionVariables.set('regNo', reg);",
                  "console.log('Generated customer: ' + email + ' with vehicle: ' + reg);"
                ],
                "type": "text/javascript"
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201 || pm.response.code === 200) {",
                  "    var data = pm.response.json();",
                  "    pm.collectionVariables.set('customerToken', data.token);",
                  "    console.log('Customer token saved!');",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Vedant Gosavi\",\n  \"email\": \"{{customerEmail}}\",\n  \"password\": \"password123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/signup",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "signup"]
            }
          }
        },
        {
          "name": "1.2 Customer Login (Alternative)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    var data = pm.response.json();",
                  "    pm.collectionVariables.set('customerToken', data.token);",
                  "    console.log('Customer token loaded!');",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{customerEmail}}\",\n  \"password\": \"password123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "login"]
            }
          }
        },
        {
          "name": "1.3 Get Services Catalog",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{customerToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/services?category=FOUR_WHEELER&subType=Petrol",
              "host": ["{{baseUrl}}"],
              "path": ["api", "services"],
              "query": [
                {
                  "key": "category",
                  "value": "FOUR_WHEELER"
                },
                {
                  "key": "subType",
                  "value": "Petrol"
                }
              ]
            }
          }
        },
        {
          "name": "1.4 Add Vehicle",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{customerToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"registrationNumber\": \"{{regNo}}\",\n  \"ownerName\": \"Vedant Gosavi\",\n  \"modelName\": \"Honda City VMT\",\n  \"category\": \"FOUR_WHEELER\",\n  \"subType\": \"Petrol\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/vehicles",
              "host": ["{{baseUrl}}"],
              "path": ["api", "vehicles"]
            }
          }
        },
        {
          "name": "1.5 Get Customer Vehicles",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{customerToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/vehicles",
              "host": ["{{baseUrl}}"],
              "path": ["api", "vehicles"]
            }
          }
        },
        {
          "name": "1.6 Create Booking",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201 || pm.response.code === 200) {",
                  "    var data = pm.response.json();",
                  "    var bId = data.bookingId || data.id;",
                  "    if (bId) {",
                  "        pm.collectionVariables.set('bookingId', bId);",
                  "        console.log('Saved bookingId: ' + bId);",
                  "    }",
                  "    if (data.jobs && data.jobs.length > 0) {",
                  "        var jId = data.jobs[0].jobId || data.jobs[0].id;",
                  "        if (jId) {",
                  "            pm.collectionVariables.set('jobId', jId);",
                  "            console.log('Saved jobId: ' + jId);",
                  "        }",
                  "    }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{customerToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"vehicleRegNo\": \"{{regNo}}\",\n  \"date\": \"2026-11-01\",\n  \"serviceItemIds\": [\"4w-p-1\", \"4w-p-2\"]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/bookings",
              "host": ["{{baseUrl}}"],
              "path": ["api", "bookings"]
            }
          }
        },
        {
          "name": "1.7 Get Customer Bookings",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{customerToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/bookings",
              "host": ["{{baseUrl}}"],
              "path": ["api", "bookings"]
            }
          }
        }
      ]
    },
    {
      "name": "2. Mechanic Flow",
      "item": [
        {
          "name": "2.1 Mechanic Login (Amit - Four Wheeler)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    var data = pm.response.json();",
                  "    pm.collectionVariables.set('mechanicToken', data.token);",
                  "    console.log('Mechanic token saved successfully!');",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"amit@vehicleservice.com\",\n  \"password\": \"mech123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "login"]
            }
          }
        },
        {
          "name": "2.2 Get Mechanic Jobs",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    var jobs = pm.response.json();",
                  "    if (Array.isArray(jobs) && jobs.length > 0) {",
                  "        var firstPending = jobs.find(function(j) { return j.status === 'PENDING' || j.status === 'IN_PROGRESS'; }) || jobs[0];",
                  "        var jId = firstPending.jobId || firstPending.id;",
                  "        if (jId) {",
                  "            pm.collectionVariables.set('jobId', jId);",
                  "            console.log('Active jobId set to: ' + jId);",
                  "        }",
                  "    }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{mechanicToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/mechanic/jobs",
              "host": ["{{baseUrl}}"],
              "path": ["api", "mechanic", "jobs"]
            }
          }
        },
        {
          "name": "2.3 Update Job to IN_PROGRESS",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{mechanicToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"IN_PROGRESS\",\n  \"notes\": \"Started oil change and inspection\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/mechanic/jobs/{{jobId}}/status",
              "host": ["{{baseUrl}}"],
              "path": ["api", "mechanic", "jobs", "{{jobId}}", "status"]
            }
          }
        },
        {
          "name": "2.4 Update Job to COMPLETED",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{mechanicToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"COMPLETED\",\n  \"notes\": \"Service completed and inspected\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/mechanic/jobs/{{jobId}}/status",
              "host": ["{{baseUrl}}"],
              "path": ["api", "mechanic", "jobs", "{{jobId}}", "status"]
            }
          }
        }
      ]
    },
    {
      "name": "3. Billing Flow",
      "item": [
        {
          "name": "3.1 Get Bill for Booking",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{customerToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/bills/{{bookingId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "bills", "{{bookingId}}"]
            }
          }
        },
        {
          "name": "3.2 Check Vehicle Service History Stack",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{customerToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/vehicles/{{regNo}}/history",
              "host": ["{{baseUrl}}"],
              "path": ["api", "vehicles", "{{regNo}}", "history"]
            }
          }
        }
      ]
    },
